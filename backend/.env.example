# JobTrail Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtrail_db
SPRING_DATASOURCE_USERNAME=jobtrail_user
SPRING_DATASOURCE_PASSWORD=local_dev_password

# Authentication
JWT_SECRET=your_very_long_and_secure_local_development_secret_key_12345

# Google Gmail API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Config
ENCRYPTION_KEY=32_byte_base64_encoded_key_for_aes_gcm
APP_FRONTEND_URL=http://localhost:5173
APP_REDIRECT_URI=http://localhost:8080/api/gmail/callback
APP_TIMEZONE=UTC
