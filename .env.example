# JobTrail Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtrail_db
SPRING_DATASOURCE_USERNAME=jobtrail_user
SPRING_DATASOURCE_PASSWORD=local_dev_password

# Your frontend URL
VITE_API_BASE_URL=http://localhost:8080/api

# Encryption key for tokens. Must be exactly 32 bytes (base64 encoded).
# Generate one using: openssl rand -base64 32
ENCRYPTION_KEY=your_generated_base64_encryption_key_here

# Authentication
JWT_SECRET=your_very_long_and_secure_local_development_secret_key_12345

# Google Gmail API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
